# Port the local Express server listens on.
PORT=3002

# MongoDB connection string (MongoDB Atlas or local). Required.
MONGO_URL=your_mongodb_connection_string

# Secret used to sign/verify JWTs. Required.
TOKEN_KEY=your_jwt_secret_key

# Optional. Enables Redis caching for /dashboardSummary. If unset (or
# Redis is unreachable), the app automatically falls back to querying
# MongoDB directly - Redis is never required for the app to run.
REDIS_URL=your_redis_connection_string

# Leave unset or "development" for local development. The local Express
# server and Socket.IO real-time price stream only start when NODE_ENV
# is not "production".
NODE_ENV=development
