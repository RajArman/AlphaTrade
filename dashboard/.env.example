# Optional. Backend API base URL. If unset, defaults to the deployed
# production API (see dashboard/src/config.js).
VITE_API_URL=https://your-backend-url.example.com

# Optional. Socket.IO server URL for real-time simulated prices. Only
# works against a persistent backend process (e.g. `npm start`), not the
# Vercel serverless deployment. If unset, defaults to http://localhost:3002.
VITE_SOCKET_URL=http://localhost:3002
